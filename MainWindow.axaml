<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:PublicVideoLauncher.Models"
        mc:Ignorable="d"
        x:Class="PublicVideoLauncher.MainWindow"
        Title="Public Video Launcher"
        Icon="/Assets/AppIcon.png"
        Width="1280"
        Height="860"
        MinWidth="1000"
        MinHeight="700"
        Background="#020817"
        Foreground="#F8FAFC">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#F8FAFC"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="Background" Value="#172338"/>
      <Setter Property="BorderBrush" Value="#334155"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="SelectionBrush" Value="#0EA5E9"/>
    </Style>

    <Style Selector="NumericUpDown">
      <Setter Property="Foreground" Value="#22D3EE"/>
      <Setter Property="Background" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#334155"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#E2E8F0"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="Background" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#334155"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinWidth" Value="200"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#334155"/>
      <Setter Property="BorderBrush" Value="#475569"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinWidth" Value="96"/>
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#475569"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#16A34A"/>
      <Setter Property="BorderBrush" Value="#22C55E"/>
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#22C55E"/>
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#DC2626"/>
      <Setter Property="BorderBrush" Value="#EF4444"/>
    </Style>

    <Style Selector="Button.danger:pointerover">
      <Setter Property="Background" Value="#EF4444"/>
    </Style>

    <Style Selector="Button.warn">
      <Setter Property="Background" Value="#D97706"/>
      <Setter Property="BorderBrush" Value="#F59E0B"/>
    </Style>

    <Style Selector="Button.warn:pointerover">
      <Setter Property="Background" Value="#F59E0B"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,220,Auto" Margin="10" RowSpacing="10">

    <Border Grid.Row="0"
            Padding="12"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="#24324B"
            Background="#0B1220">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            RowDefinitions="Auto,Auto,Auto"
            ColumnSpacing="10"
            RowSpacing="10">

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Folder" FontWeight="Bold" VerticalAlignment="Center"/>

        <TextBox x:Name="FolderTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Watermark="Choose a folder with videos..."/>

        <Button x:Name="BrowseButton" Grid.Row="0" Grid.Column="2" Content="Browse..."/>

        <TextBlock Grid.Row="0" Grid.Column="3" Text="Port" FontWeight="Bold" VerticalAlignment="Center"/>

        <NumericUpDown x:Name="PortNumeric"
                       Grid.Row="0"
                       Grid.Column="4"
                       Width="140"
                       Minimum="1024"
                       Maximum="65535"
                       Value="8000"
                       FormatString="0"/>

        <TextBlock Grid.Row="0" Grid.Column="5" Text="Tunnel" FontWeight="Bold" VerticalAlignment="Center"/>

        <ComboBox x:Name="TunnelProviderComboBox"
                  Grid.Row="0"
                  Grid.Column="6"
                  SelectedIndex="0"
                  VerticalAlignment="Center"/>

        <CheckBox x:Name="ProxyModeCheckBox"
                  Grid.Row="0"
                  Grid.Column="7"
                  IsChecked="True"
                  VerticalAlignment="Center"
                  Content="Proxy MP4 for translation"/>

        <CheckBox x:Name="AutostartBrowserCheckBox"
                  Grid.Row="0"
                  Grid.Column="8"
                  IsChecked="True"
                  VerticalAlignment="Center"
                  Content="Open browser after start"/>

        <Button x:Name="ScanButton" Grid.Row="0" Grid.Column="9" Classes="primary" Content="Scan"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Public URL" FontWeight="Bold" VerticalAlignment="Center"/>

        <TextBox x:Name="PublicUrlTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Grid.ColumnSpan="9"
                 IsReadOnly="True"
                 Watermark="Public URL will appear here after start..."/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tunnel auth" FontWeight="Bold" VerticalAlignment="Center"/>

        <TextBox x:Name="TunnelAuthTextBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 Grid.ColumnSpan="4"
                 Watermark="zrok: account token. xTunnel: license key. Optional for Cloudflare / LocalTunnel / VK."/>

        <TextBlock Grid.Row="2" Grid.Column="5" Text="CLI path" FontWeight="Bold" VerticalAlignment="Center"/>

        <TextBox x:Name="TunnelCliPathTextBox"
                 Grid.Row="2"
                 Grid.Column="6"
                 Grid.ColumnSpan="3"
                 Watermark="Optional path to zrok / lt / xTunnel.exe / vk-tunnel.cmd / npx"/>

        <Button x:Name="TunnelSetupButton"
                Grid.Row="2"
                Grid.Column="9"
                Content="Setup..."
                IsVisible="False"/>

      </Grid>
    </Border>

    <Border Grid.Row="1"
            Padding="12"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="#24324B"
            Background="#0B1220">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Grid x:Name="DetailedHeaderGrid" Grid.Row="0" ColumnDefinitions="260,100,220,220,120,*" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Text="Title" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="1" Text="Ext" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="2" Text="Playback" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="3" Text="Translation" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="4" Text="Cache" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="5" Text="Path" FontWeight="Bold" Foreground="#7DD3FC"/>
        </Grid>

        <Grid x:Name="SimpleHeaderGrid" Grid.Row="0" ColumnDefinitions="260,100,340,*" ColumnSpacing="10" IsVisible="False">
          <TextBlock Grid.Column="0" Text="Title" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="1" Text="Ext" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="2" Text="Playback" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="3" Text="Path" FontWeight="Bold" Foreground="#7DD3FC"/>
        </Grid>

        <ListBox x:Name="VideosListBox"
                 Grid.Row="1"
                 BorderThickness="0"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:VideoEntry">
              <Border Margin="0,0,0,8"
                      Padding="10"
                      CornerRadius="10"
                      BorderThickness="1"
                      BorderBrush="#20304A"
                      Background="#101A31">
                <Grid>
                  <Grid ColumnDefinitions="260,100,220,220,120,*" ColumnSpacing="10" IsVisible="{Binding ShowProxyColumns}">
                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding Extension}"/>
                    <TextBlock Grid.Column="2" Text="{Binding PlaybackUrl}" Foreground="#60A5FA" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding TranslationUrl}" Foreground="#86EFAC" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="4" Text="{Binding CacheState}" Foreground="#FDE047"/>
                    <TextBlock Grid.Column="5" Text="{Binding FullPath}" Foreground="#93C5FD" TextTrimming="CharacterEllipsis"/>
                  </Grid>

                  <Grid ColumnDefinitions="260,100,340,*" ColumnSpacing="10" IsVisible="{Binding ShowSimpleColumns}">
                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding Extension}"/>
                    <TextBlock Grid.Column="2" Text="{Binding PlaybackUrl}" Foreground="#60A5FA" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding FullPath}" Foreground="#93C5FD" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Padding="12"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="#24324B"
            Background="#0B1220">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="Log" FontWeight="Bold"/>
        <TextBox x:Name="LogTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas, Cascadia Code, Menlo"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 Background="#020817"/>
      </Grid>
    </Border>

    <Border Grid.Row="3"
            Padding="12"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="#24324B"
            Background="#0B1220">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock x:Name="StatusTextBlock" Text="Idle" FontWeight="Bold" FontSize="15"/>
          <TextBlock x:Name="SummaryTextBlock" Text="Ready." Foreground="#93C5FD"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
          <CheckBox x:Name="MergeTranslationCheckBox"
                    VerticalAlignment="Center"
                    Content="Auto merge translated audio and save output"/>
          <Button x:Name="StartButton" Classes="primary" Content="Start"/>
          <Button x:Name="StopButton" Classes="danger" Content="Stop" IsEnabled="False"/>
          <Button x:Name="CopyUrlButton" Content="Copy URL" IsEnabled="False"/>
          <Button x:Name="OpenUrlButton" Content="Open" IsEnabled="False"/>
          <Button x:Name="DependenciesButton" Content="Dependencies"/>
          <Button x:Name="FixDnsButton" Classes="warn" Content="Fix DNS"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
