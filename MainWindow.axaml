<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:PublicVideoLauncher.Models"
        mc:Ignorable="d"
        x:Class="PublicVideoLauncher.MainWindow"
        Title="Public Video Launcher"
        Icon="/Assets/AppIcon.png"
        Width="1280"
        Height="860"
        MinWidth="1000"
        MinHeight="700"
        Background="#020817"
        Foreground="#F8FAFC">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#F8FAFC"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="Background" Value="#172338"/>
      <Setter Property="BorderBrush" Value="#334155"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="SelectionBrush" Value="#0EA5E9"/>
    </Style>

    <Style Selector="NumericUpDown">
      <Setter Property="Foreground" Value="#22D3EE"/>
      <Setter Property="Background" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#334155"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#E2E8F0"/>
    </Style>

    <Style Selector="CheckBox.success">
      <Setter Property="Foreground" Value="#86EFAC"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="Background" Value="#0F172A"/>
      <Setter Property="BorderBrush" Value="#334155"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinWidth" Value="200"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#334155"/>
      <Setter Property="BorderBrush" Value="#475569"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinWidth" Value="96"/>
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#475569"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#16A34A"/>
      <Setter Property="BorderBrush" Value="#22C55E"/>
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#22C55E"/>
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#DC2626"/>
      <Setter Property="BorderBrush" Value="#EF4444"/>
    </Style>

    <Style Selector="Button.danger:pointerover">
      <Setter Property="Background" Value="#EF4444"/>
    </Style>

    <Style Selector="Button.warn">
      <Setter Property="Background" Value="#D97706"/>
      <Setter Property="BorderBrush" Value="#F59E0B"/>
    </Style>

    <Style Selector="Button.warn:pointerover">
      <Setter Property="Background" Value="#F59E0B"/>
    </Style>

    <Style Selector="Button.info">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="BorderBrush" Value="#3B82F6"/>
    </Style>

    <Style Selector="Button.info:pointerover">
      <Setter Property="Background" Value="#3B82F6"/>
    </Style>

    <Style Selector="ProgressBar.mainBusy">
      <Setter Property="Height" Value="8"/>
      <Setter Property="MinWidth" Value="220"/>
      <Setter Property="IsIndeterminate" Value="True"/>
      <Setter Property="Foreground" Value="#22C55E"/>
      <Setter Property="Background" Value="#172338"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,220,Auto" Margin="10" RowSpacing="10">

    <Border Grid.Row="0"
            Padding="12"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="#24324B"
            Background="#0B1220">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            RowSpacing="10">

        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="10">
          <TextBlock Grid.Column="0" Text="Folder" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBox x:Name="FolderTextBox"
                   Grid.Column="1"
                   IsReadOnly="True"
                   Watermark="Choose a folder with videos..."/>
          <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse"/>
        </Grid>

        <WrapPanel Grid.Row="1" Orientation="Horizontal">
          <TextBlock Text="Port" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,8"/>
          <NumericUpDown x:Name="PortNumeric"
                         Width="140"
                         Minimum="1024"
                         Maximum="65535"
                         Value="8000"
                         FormatString="0"
                         Margin="0,0,16,8"/>

          <TextBlock Text="Tunnel" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,8"/>
          <ComboBox x:Name="TunnelProviderComboBox"
                    Width="230"
                    SelectedIndex="0"
                    VerticalAlignment="Center"
                    Margin="0,0,16,8"/>

          <CheckBox x:Name="ProxyModeCheckBox"
                    IsChecked="True"
                    VerticalAlignment="Center"
                    Content="Convert to MP4"
                    Margin="0,0,16,8"/>

          <CheckBox x:Name="AutostartBrowserCheckBox"
                    IsChecked="True"
                    VerticalAlignment="Center"
                    Content="Open browser after start"
                    Margin="0,0,16,8"/>

          <Button x:Name="ScanButton" Classes="primary" Content="Scan Folder" Margin="0,0,0,8"/>
        </WrapPanel>

        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="10">
          <TextBlock Grid.Column="0" Text="Public URL" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBox x:Name="PublicUrlTextBox"
                    Grid.Column="1"
                    IsReadOnly="True"
                    Watermark="Public URL will appear here after start..."/>
          <Button x:Name="CopyUrlButton"
                  Grid.Column="2"
                  Classes="info"
                  Content="Copy"
                  IsEnabled="False"/>
        </Grid>

        <Grid Grid.Row="3"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="10">
          <TextBlock Grid.Column="0" Text="Tunnel auth" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBox x:Name="TunnelAuthTextBox"
                   Grid.Column="1"
                   Watermark="zrok: account token. xTunnel: license key. Optional for Cloudflare / LocalTunnel / VK."/>

          <TextBox x:Name="TunnelCliPathTextBox"
                   Grid.Column="1"
                   IsVisible="False"
                   Watermark="Optional path to zrok / lt / xTunnel.exe / vk-tunnel.cmd / npx"/>

          <Button x:Name="TunnelSetupButton"
                  Grid.Column="2"
                  Content="Setup..."
                  IsVisible="False"/>
        </Grid>

        <WrapPanel Grid.Row="4" Orientation="Horizontal">
          <CheckBox x:Name="MergeTranslationCheckBox"
                    Classes="success"
                    VerticalAlignment="Center"
                    Margin="0,0,18,8"
                    Content="Auto merge translated audio and save output"/>

          <CheckBox x:Name="AutoProcessNextVideoCheckBox"
                    VerticalAlignment="Center"
                    Margin="0,0,18,8"
                    Content="Auto process next video"/>

          <TextBlock Text="Original %" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,8"/>
          <NumericUpDown x:Name="OriginalAudioVolumeNumeric"
                         Width="111"
                         Minimum="0"
                         Maximum="100"
                         Increment="1"
                         Value="25"
                         FormatString="0"
                         Margin="0,0,18,8"/>

          <TextBlock Text="MP3 %" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,8"/>
          <NumericUpDown x:Name="TranslatedAudioVolumeNumeric"
                         Width="111"
                         Minimum="0"
                         Maximum="100"
                         Increment="1"
                         Value="100"
                         FormatString="0"
                         Margin="0,0,0,8"/>
        </WrapPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Padding="12"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="#24324B"
            Background="#0B1220">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock x:Name="SelectionSummaryTextBlock"
                     Grid.Column="0"
                     Text="Found: 0 | Selected: 0"
                     FontWeight="Bold"
                     Foreground="#93C5FD"
                     VerticalAlignment="Center"/>
          <Button x:Name="SelectAllButton" Grid.Column="1" Content="Select all"/>
          <Button x:Name="UnselectAllButton" Grid.Column="2" Content="Unselect all"/>
          <Button x:Name="InvertSelectionButton" Grid.Column="3" Content="Invert selection"/>
          <Button x:Name="RetryFailedButton" Grid.Column="4" Content="Retry failed"/>
        </Grid>

        <Grid x:Name="DetailedHeaderGrid" Grid.Row="1" ColumnDefinitions="44,260,100,220,220,120,*" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Text="Use" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="1" Text="Title" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="2" Text="Ext" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="3" Text="Playback" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="4" Text="Translation" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="5" Text="Cache" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="6" Text="Path" FontWeight="Bold" Foreground="#7DD3FC"/>
        </Grid>

        <Grid x:Name="SimpleHeaderGrid" Grid.Row="1" ColumnDefinitions="44,260,100,340,*" ColumnSpacing="10" IsVisible="False">
          <TextBlock Grid.Column="0" Text="Use" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="1" Text="Title" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="2" Text="Ext" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="3" Text="Playback" FontWeight="Bold" Foreground="#7DD3FC"/>
          <TextBlock Grid.Column="4" Text="Path" FontWeight="Bold" Foreground="#7DD3FC"/>
        </Grid>

        <ListBox x:Name="VideosListBox"
                 Grid.Row="2"
                 BorderThickness="0"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:VideoEntry">
              <Border Margin="0,0,0,8"
                      Padding="10"
                      CornerRadius="10"
                      BorderThickness="1"
                      BorderBrush="#20304A"
                      Background="#101A31">
                  <Grid>
                   <Grid ColumnDefinitions="44,260,100,220,220,120,*" ColumnSpacing="10" IsVisible="{Binding ShowProxyColumns}">
                     <CheckBox Grid.Column="0"
                               IsChecked="{Binding IncludeInBatch}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"/>
                     <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                     <TextBlock Grid.Column="2" Text="{Binding Extension}"/>
                     <TextBlock Grid.Column="3" Text="{Binding PlaybackUrl}" Foreground="#60A5FA" TextTrimming="CharacterEllipsis"/>
                     <TextBlock Grid.Column="4" Text="{Binding TranslationUrl}" Foreground="#86EFAC" TextTrimming="CharacterEllipsis"/>
                     <TextBlock Grid.Column="5" Text="{Binding CacheState}" Foreground="#FDE047"/>
                     <TextBlock Grid.Column="6" Text="{Binding FullPath}" Foreground="#93C5FD" TextTrimming="CharacterEllipsis"/>
                   </Grid>

                   <Grid ColumnDefinitions="44,260,100,340,*" ColumnSpacing="10" IsVisible="{Binding ShowSimpleColumns}">
                     <CheckBox Grid.Column="0"
                               IsChecked="{Binding IncludeInBatch}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"/>
                     <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                     <TextBlock Grid.Column="2" Text="{Binding Extension}"/>
                     <TextBlock Grid.Column="3" Text="{Binding PlaybackUrl}" Foreground="#60A5FA" TextTrimming="CharacterEllipsis"/>
                     <TextBlock Grid.Column="4" Text="{Binding FullPath}" Foreground="#93C5FD" TextTrimming="CharacterEllipsis"/>
                   </Grid>
                 </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Padding="12"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="#24324B"
            Background="#0B1220">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="Log" FontWeight="Bold"/>
        <TextBox x:Name="LogTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas, Cascadia Code, Menlo"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 Background="#020817"/>
      </Grid>
    </Border>

    <Border Grid.Row="3"
            Padding="12"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="#24324B"
            Background="#0B1220">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock x:Name="StatusTextBlock" Text="Idle" FontWeight="Bold" FontSize="15"/>
          <TextBlock x:Name="SummaryTextBlock" Text="Ready." Foreground="#93C5FD"/>
          <StackPanel Orientation="Vertical" Spacing="4">
            <TextBlock x:Name="BusyTextBlock" Text="" Foreground="#86EFAC" IsVisible="False"/>
            <ProgressBar x:Name="BusyProgressBar" Classes="mainBusy" IsVisible="False"/>
          </StackPanel>
        </StackPanel>

        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <ComboBox x:Name="LanguageComboBox"
                    Width="130"
                    MinWidth="130"
                    Margin="0,0,8,8"/>
          <Button x:Name="StartButton" Classes="primary" Content="Start" Margin="0,0,8,8"/>
          <Button x:Name="StopButton" Classes="danger" Content="Stop" IsEnabled="False" Margin="0,0,8,8"/>
          <Button x:Name="OpenUrlButton" Content="Open" IsEnabled="False" Margin="0,0,8,8"/>
          <Button x:Name="TranslationStudioButton" Classes="info" Content="Translation" Margin="0,0,8,8"/>
          <Button x:Name="DependenciesButton" Content="Tools" Margin="0,0,8,8"/>
          <Button x:Name="FixDnsButton" Classes="warn" Content="DNS" Margin="0,0,0,8"/>
        </WrapPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
